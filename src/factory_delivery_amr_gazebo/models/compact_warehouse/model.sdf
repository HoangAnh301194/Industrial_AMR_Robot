<?xml version="1.0"?>
<sdf version="1.9">
  <model name="compact_warehouse">
    <static>true</static>

    <link name="warehouse_structure">
      <pose>0 0 0 0 0 0</pose>

      <!-- =========================================================== -->
      <!-- EPOXY FLOOR & SAFETY AISLE MARKINGS (VISUAL ONLY)           -->
      <!-- Interior span: X in [-7.0, +9.0] (16m), Y in [-5.0, +5.0] (10m) -->
      <!-- =========================================================== -->
      <visual name="epoxy_floor_visual">
        <pose>1.0 0.0 0.001 0 0 0</pose>
        <geometry>
          <box><size>16.0 10.0 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.36 0.39 0.43 1</ambient>
          <diffuse>0.42 0.45 0.50 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <visual name="center_aisle_stripe_north">
        <pose>1.0 0.72 0.003 0 0 0</pose>
        <geometry>
          <box><size>13.0 0.06 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.10 1</ambient>
          <diffuse>0.95 0.75 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="center_aisle_stripe_south">
        <pose>1.0 -0.72 0.003 0 0 0</pose>
        <geometry>
          <box><size>13.0 0.06 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.10 1</ambient>
          <diffuse>0.95 0.75 0.10 1</diffuse>
        </material>
      </visual>

      <!-- =========================================================== -->
      <!-- PERIMETER WALLS (H = 2.6 m, THICKNESS = 0.25 m)             -->
      <!-- =========================================================== -->
      <collision name="north_wall_col">
        <pose>1.0 5.125 1.3 0 0 0</pose>
        <geometry><box><size>16.5 0.25 2.6</size></box></geometry>
      </collision>
      <visual name="north_wall_vis">
        <pose>1.0 5.125 1.3 0 0 0</pose>
        <geometry><box><size>16.5 0.25 2.6</size></box></geometry>
        <material>
          <ambient>0.72 0.75 0.78 1</ambient>
          <diffuse>0.82 0.85 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="north_wall_trim">
        <pose>1.0 4.995 0.12 0 0 0</pose>
        <geometry><box><size>16.0 0.02 0.24</size></box></geometry>
        <material>
          <ambient>0.18 0.32 0.52 1</ambient>
          <diffuse>0.22 0.38 0.62 1</diffuse>
        </material>
      </visual>

      <collision name="south_wall_col">
        <pose>1.0 -5.125 1.3 0 0 0</pose>
        <geometry><box><size>16.5 0.25 2.6</size></box></geometry>
      </collision>
      <visual name="south_wall_vis">
        <pose>1.0 -5.125 1.3 0 0 0</pose>
        <geometry><box><size>16.5 0.25 2.6</size></box></geometry>
        <material>
          <ambient>0.72 0.75 0.78 1</ambient>
          <diffuse>0.82 0.85 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="south_wall_trim">
        <pose>1.0 -4.995 0.12 0 0 0</pose>
        <geometry><box><size>16.0 0.02 0.24</size></box></geometry>
        <material>
          <ambient>0.18 0.32 0.52 1</ambient>
          <diffuse>0.22 0.38 0.62 1</diffuse>
        </material>
      </visual>

      <collision name="west_wall_col">
        <pose>-7.125 0.0 1.3 0 0 0</pose>
        <geometry><box><size>0.25 10.5 2.6</size></box></geometry>
      </collision>
      <visual name="west_wall_vis">
        <pose>-7.125 0.0 1.3 0 0 0</pose>
        <geometry><box><size>0.25 10.5 2.6</size></box></geometry>
        <material>
          <ambient>0.72 0.75 0.78 1</ambient>
          <diffuse>0.82 0.85 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="west_wall_trim">
        <pose>-6.995 0.0 0.12 0 0 0</pose>
        <geometry><box><size>0.02 10.0 0.24</size></box></geometry>
        <material>
          <ambient>0.18 0.32 0.52 1</ambient>
          <diffuse>0.22 0.38 0.62 1</diffuse>
        </material>
      </visual>

      <collision name="east_wall_col">
        <pose>9.125 0.0 1.3 0 0 0</pose>
        <geometry><box><size>0.25 10.5 2.6</size></box></geometry>
      </collision>
      <visual name="east_wall_vis">
        <pose>9.125 0.0 1.3 0 0 0</pose>
        <geometry><box><size>0.25 10.5 2.6</size></box></geometry>
        <material>
          <ambient>0.72 0.75 0.78 1</ambient>
          <diffuse>0.82 0.85 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="east_wall_trim">
        <pose>8.995 0.0 0.12 0 0 0</pose>
        <geometry><box><size>0.02 10.0 0.24</size></box></geometry>
        <material>
          <ambient>0.18 0.32 0.52 1</ambient>
          <diffuse>0.22 0.38 0.62 1</diffuse>
        </material>
      </visual>

      <!-- =========================================================== -->
      <!-- TWO-ROOM HORIZONTAL LAYOUT (LEFT: PICKUP, RIGHT: DROP-OFF)  -->
      <!-- Divided at X = 1.0 with a 1.20 m central doorway (Y in [-0.6, +0.6]) -->
      <!-- All rack & corridor aisles are 1.20 m wide                  -->
      <!-- =========================================================== -->

      <!-- Visual-only room floor tinting -->
      <visual name="left_room_pickup_floor">
        <pose>-3.06 0.0 0.002 0 0 0</pose>
        <geometry><box><size>7.88 10.0 0.002</size></box></geometry>
        <material>
          <ambient>0.46 0.43 0.34 1</ambient>
          <diffuse>0.55 0.51 0.40 1</diffuse>
        </material>
      </visual>

      <visual name="right_room_dropoff_floor">
        <pose>5.06 0.0 0.002 0 0 0</pose>
        <geometry><box><size>7.88 10.0 0.002</size></box></geometry>
        <material>
          <ambient>0.34 0.44 0.42 1</ambient>
          <diffuse>0.40 0.54 0.50 1</diffuse>
        </material>
      </visual>

      <!-- Center Dividing Wall at X = 1.0 (1.20 m doorway at Y in [-0.60, +0.60]) -->
      <collision name="center_wall_north_col">
        <pose>1.0 2.8 0.9 0 0 0</pose>
        <geometry><box><size>0.25 4.4 1.8</size></box></geometry>
      </collision>
      <visual name="center_wall_north_vis">
        <pose>1.0 2.8 0.9 0 0 0</pose>
        <geometry><box><size>0.25 4.4 1.8</size></box></geometry>
        <material>
          <ambient>0.62 0.66 0.70 1</ambient>
          <diffuse>0.72 0.76 0.80 1</diffuse>
        </material>
      </visual>

      <collision name="center_wall_south_col">
        <pose>1.0 -2.8 0.9 0 0 0</pose>
        <geometry><box><size>0.25 4.4 1.8</size></box></geometry>
      </collision>
      <visual name="center_wall_south_vis">
        <pose>1.0 -2.8 0.9 0 0 0</pose>
        <geometry><box><size>0.25 4.4 1.8</size></box></geometry>
        <material>
          <ambient>0.62 0.66 0.70 1</ambient>
          <diffuse>0.72 0.76 0.80 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
