<?xml version="1.0"?>

<robot
  name="factory_delivery_amr"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================ -->
  <!-- MULTI-ROBOT NAMESPACE / TOPIC PREFIX ARGUMENT                    -->
  <!--   default=""       -> /cmd_vel, /odom, /lift_position, ...       -->
  <!--   topic_prefix:=/amr_1 -> /amr_1/cmd_vel, /amr_1/odom, ...       -->
  <!--   topic_prefix:=/amr_2 -> /amr_2/cmd_vel, /amr_2/odom, ...       -->
  <!-- ================================================================ -->

  <xacro:arg name="topic_prefix" default=""/>
  <xacro:property name="prefix" value="$(arg topic_prefix)"/>

  <!-- ================================================================ -->
  <!-- PARAMETERS                                                       -->
  <!-- Units: meters, kilograms, radians                                -->
  <!-- ================================================================ -->

  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- Main drive wheels -->
  <xacro:property name="wheel_radius" value="0.110"/>
  <xacro:property name="wheel_width" value="0.060"/>
  <xacro:property name="wheel_separation" value="0.620"/>

  <!-- Caster positions and collision geometry -->
  <xacro:property name="caster_x_offset" value="0.310"/>
  <xacro:property name="caster_y_offset" value="0.245"/>

  <!--
    Main-wheel ground contact:
      center Z = 0.110
      radius   = 0.110
      bottom Z = 0.000

    Caster ground contact:
      center Z = 0.035
      radius   = 0.035
      bottom Z = 0.000
  -->

  <xacro:property name="caster_collision_radius" value="0.035"/>
  <xacro:property name="caster_collision_z" value="0.035"/>

  <!-- Lift mechanism (supports 2-level smart rack up to 0.290 m) -->
  <xacro:property name="lift_x" value="-0.015"/>
  <xacro:property name="lift_lowered_z" value="0.330"/>
  <xacro:property name="lift_travel" value="0.290"/>

  <!-- Scissor mechanism (calibrated for 0.290 m vertical travel) -->
  <xacro:property name="scissor_bar_length" value="0.428"/>
  <xacro:property name="scissor_bar_width" value="0.016"/>
  <xacro:property name="scissor_bar_height" value="0.016"/>

  <xacro:property name="scissor_center_x" value="-0.015"/>
  <xacro:property name="scissor_x_offset" value="0.135"/>
  <xacro:property name="scissor_lower_z" value="0.268"/>

  <xacro:property name="scissor_y_outer" value="0.112"/>
  <xacro:property name="scissor_y_inner" value="0.098"/>


  <!-- ================================================================ -->
  <!-- HIGH-FIDELITY MATERIALS (SYNCHRONIZED WITH main.scad)           -->
  <!-- ================================================================ -->

  <material name="dark_blue">
    <color rgba="0.10 0.26 0.48 1.0"/>
  </material>

  <material name="panel_blue">
    <color rgba="0.12 0.34 0.62 1.0"/>
  </material>

  <material name="cyan_led">
    <color rgba="0.00 0.85 0.95 1.0"/>
  </material>

  <material name="bumper_black">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>

  <material name="safety_yellow">
    <color rgba="0.95 0.78 0.05 1.0"/>
  </material>

  <material name="safety_red">
    <color rgba="0.88 0.08 0.08 1.0"/>
  </material>

  <material name="copper_gold">
    <color rgba="0.88 0.65 0.18 1.0"/>
  </material>

  <material name="aluminum_silver">
    <color rgba="0.78 0.80 0.84 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.14 0.14 0.16 1.0"/>
  </material>

  <material name="lift_orange">
    <color rgba="0.92 0.58 0.08 1.0"/>
  </material>

  <material name="deck_pad_gray">
    <color rgba="0.22 0.24 0.26 1.0"/>
  </material>

  <material name="payload_brown">
    <color rgba="0.72 0.52 0.32 1.0"/>
  </material>

  <material name="steel_gray">
    <color rgba="0.62 0.65 0.70 1.0"/>
  </material>

  <material name="pedestal_gray">
    <color rgba="0.28 0.30 0.34 1.0"/>
  </material>

  <material name="lidar_dark">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>

  <material name="optical_glass">
    <color rgba="0.05 0.08 0.15 1.0"/>
  </material>

  <material name="metal_gray">
    <color rgba="0.50 0.53 0.57 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.82 0.84 0.88 1.0"/>
  </material>

  <material name="scissor_orange">
    <color rgba="0.82 0.48 0.08 1.0"/>
  </material>

  <material name="pcb_green">
    <color rgba="0.08 0.50 0.22 1.0"/>
  </material>


  <!-- ================================================================ -->
  <!-- BASE FRAMES                                                      -->
  <!-- ================================================================ -->

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>
  </joint>

  <link name="base_link">

    <inertial>
      <origin
        xyz="0 0 0.145"
        rpy="0 0 0"/>

      <mass value="40.0"/>

      <inertia
        ixx="2.00"
        ixy="0.0"
        ixz="0.0"
        iyy="2.70"
        iyz="0.0"
        izz="4.20"/>
    </inertial>

    <!-- Central chassis collision: spans Y = -0.260..+0.260 m (clear of drive wheels at Y = +-0.310 m!) -->
    <collision name="chassis_center_collision">
      <origin
        xyz="0 0 0.166"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.760 0.520 0.250"/>
      </geometry>
    </collision>

    <!-- Front nose bumper collision -->
    <collision name="front_nose_collision">
      <origin
        xyz="0.360 0 0.130"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.130 0.700 0.190"/>
      </geometry>
    </collision>

    <!-- Rear bumper collision -->
    <collision name="rear_nose_collision">
      <origin
        xyz="-0.360 0 0.130"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.130 0.700 0.190"/>
      </geometry>
    </collision>

  </link>


  <!-- ================================================================ -->
  <!-- FIXED MESH LINK MACRO                                            -->
  <!-- ================================================================ -->

  <xacro:macro
    name="fixed_mesh_link"
    params="link_name joint_name mesh_file material_name color_rgba">

    <link name="${link_name}">

      <visual name="${link_name}_visual">
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://factory_delivery_amr_description/meshes/${mesh_file}"
            scale="${mesh_scale}"/>
        </geometry>

        <material name="${material_name}">
          <color rgba="${color_rgba}"/>
        </material>
      </visual>

    </link>

    <joint name="${joint_name}" type="fixed">
      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- CASTER COLLISION MACRO                                           -->
  <!--                                                                  -->
  <!-- The detailed caster appearance remains inside casters_visual.stl.-->
  <!-- This macro creates one spherical physical contact per caster.    -->
  <!-- ================================================================ -->

  <xacro:macro
    name="caster_collision"
    params="link_name joint_name x y">

    <link name="${link_name}">

      <collision name="${link_name}_collision">
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <geometry>
          <sphere radius="${caster_collision_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <mass value="0.20"/>

        <inertia
          ixx="0.000098"
          ixy="0.0"
          ixz="0.0"
          iyy="0.000098"
          iyz="0.0"
          izz="0.000098"/>
      </inertial>

    </link>

    <joint name="${joint_name}" type="fixed">
      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="${x} ${y} ${caster_collision_z}"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- FIXED ROBOT COMPONENTS                                           -->
  <!-- ================================================================ -->

  <xacro:fixed_mesh_link
    link_name="chassis_link"
    joint_name="chassis_joint"
    mesh_file="chassis_visual.stl"
    material_name="metal_gray"
    color_rgba="0.50 0.53 0.57 1.0"/>

  <!-- BODY SHELL ASSEMBLY WITH MULTI-MATERIAL VISUAL ELEMENTS -->
  <link name="body_shell_link">
    <!-- 1. Main outer body shell (deep industrial blue) -->
    <visual name="body_shell_main_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/body_shell_main_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.10 0.26 0.48 1.0"/>
      </material>
    </visual>

    <!-- 2. Detachable service cover skin panels (modular blue) -->
    <visual name="body_skin_panels_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/body_skin_panels_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="panel_blue">
        <color rgba="0.12 0.34 0.62 1.0"/>
      </material>
    </visual>

    <!-- 3. Industrial LED status light bars (cyan) -->
    <visual name="body_status_lights_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/body_status_lights_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="cyan_led">
        <color rgba="0.00 0.85 0.95 1.0"/>
      </material>
    </visual>

    <!-- 4. Lower perimeter elastomer bumper skirt (black) -->
    <visual name="body_bumper_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/body_bumper_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="bumper_black">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual>

    <!-- 5. Yellow corner hazard stripes -->
    <visual name="body_hazard_stripes_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/body_hazard_stripes_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="safety_yellow">
        <color rgba="0.95 0.78 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="body_shell_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_shell_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:fixed_mesh_link
    link_name="casters_link"
    joint_name="casters_joint"
    mesh_file="casters_visual.stl"
    material_name="wheel_black"
    color_rgba="0.14 0.14 0.16 1.0"/>


  <!-- ================================================================ -->
  <!-- FOUR PHYSICAL CASTER CONTACTS                                    -->
  <!-- All four caster spheres touch the ground at Z = 0.               -->
  <!-- ================================================================ -->

  <xacro:caster_collision
    link_name="caster_front_left_link"
    joint_name="caster_front_left_joint"
    x="${caster_x_offset}"
    y="${caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_front_right_link"
    joint_name="caster_front_right_joint"
    x="${caster_x_offset}"
    y="${-caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_rear_left_link"
    joint_name="caster_rear_left_joint"
    x="${-caster_x_offset}"
    y="${caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_rear_right_link"
    joint_name="caster_rear_right_joint"
    x="${-caster_x_offset}"
    y="${-caster_y_offset}"/>


  <!-- BATTERY SYSTEM WITH ENCLOSURE AND SMART BMS -->
  <link name="battery_system_link">
    <!-- 48V 30Ah Li-ion battery enclosure -->
    <visual name="battery_pack_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/battery_pack_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.10 0.26 0.48 1.0"/>
      </material>
    </visual>

    <!-- Smart BMS module -->
    <visual name="bms_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/bms_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="pcb_green">
        <color rgba="0.15 0.42 0.25 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="battery_system_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_system_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ELECTRONICS BAY WITH MULTI-COLOR BOARDS AND MODULES -->
  <link name="electronics_link">
    <visual name="pdu_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/pdu_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="metal_gray">
        <color rgba="0.20 0.24 0.28 1.0"/>
      </material>
    </visual>

    <visual name="motor_drivers_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/motor_drivers_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="driver_gray">
        <color rgba="0.16 0.18 0.22 1.0"/>
      </material>
    </visual>

    <visual name="esp32_s3_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/esp32_s3_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="pcb_green">
        <color rgba="0.08 0.50 0.22 1.0"/>
      </material>
    </visual>

    <visual name="jetson_sbc_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/jetson_sbc_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="jetson_dark">
        <color rgba="0.15 0.17 0.20 1.0"/>
      </material>
    </visual>

    <visual name="imu_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/imu_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="imu_orange">
        <color rgba="0.85 0.32 0.12 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="electronics_joint" type="fixed">
    <parent link="base_link"/>
    <child link="electronics_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:fixed_mesh_link
    link_name="fixed_drive_hardware_link"
    joint_name="fixed_drive_hardware_joint"
    mesh_file="fixed_drive_hardware_visual.stl"
    material_name="metal_gray"
    color_rgba="0.32 0.35 0.38 1.0"/>

  <!-- SAFETY COMPONENTS: RED E-STOP + YELLOW COLLAR + BLACK BLOCK + GOLD CONTACTS -->
  <link name="safety_components_link">
    <!-- E-Stop Mushroom head (red) -->
    <visual name="estop_button_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/estop_button_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="safety_red">
        <color rgba="0.88 0.08 0.08 1.0"/>
      </material>
    </visual>

    <!-- E-Stop base collar (yellow) -->
    <visual name="estop_collar_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/estop_collar_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="safety_yellow">
        <color rgba="0.95 0.80 0.05 1.0"/>
      </material>
    </visual>

    <!-- Charging contacts insulated housing (black) -->
    <visual name="charging_contacts_housing_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/charging_contacts_housing_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="bumper_black">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>

    <!-- Charging contacts brass/copper pads & alignment pin (gold/copper) -->
    <visual name="charging_contacts_plates_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/charging_contacts_plates_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="copper_gold">
        <color rgba="0.88 0.65 0.18 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="safety_components_joint" type="fixed">
    <parent link="base_link"/>
    <child link="safety_components_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- LEFT DRIVE WHEEL (TIRE + CNC SILVER ALUMINUM HUB)                -->
  <!-- ================================================================ -->

  <link name="left_wheel_link">

    <visual name="left_wheel_tire_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/left_wheel_tire_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="wheel_black">
        <color rgba="0.14 0.14 0.16 1.0"/>
      </material>
    </visual>

    <visual name="left_wheel_hub_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/left_wheel_hub_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="aluminum_silver">
        <color rgba="0.78 0.80 0.84 1.0"/>
      </material>
    </visual>

    <collision name="left_wheel_collision">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="2.2"/>

      <inertia
        ixx="0.007315"
        ixy="0.0"
        ixz="0.0"
        iyy="0.013310"
        iyz="0.0"
        izz="0.007315"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin
      xyz="0 0.310 0.110"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      effort="80.0"
      velocity="20.0"/>

    <dynamics
      damping="0.1"
      friction="0.05"/>
  </joint>


  <!-- ================================================================ -->
  <!-- RIGHT DRIVE WHEEL (TIRE + CNC SILVER ALUMINUM HUB)               -->
  <!-- ================================================================ -->

  <link name="right_wheel_link">

    <visual name="right_wheel_tire_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/right_wheel_tire_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="wheel_black">
        <color rgba="0.14 0.14 0.16 1.0"/>
      </material>
    </visual>

    <visual name="right_wheel_hub_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/right_wheel_hub_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="aluminum_silver">
        <color rgba="0.78 0.80 0.84 1.0"/>
      </material>
    </visual>

    <collision name="right_wheel_collision">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="2.2"/>

      <inertia
        ixx="0.007315"
        ixy="0.0"
        ixz="0.0"
        iyy="0.013310"
        iyz="0.0"
        izz="0.007315"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin
      xyz="0 -0.310 0.110"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      effort="80.0"
      velocity="20.0"/>

    <dynamics
      damping="0.1"
      friction="0.05"/>
  </joint>


  <!-- ================================================================ -->
  <!-- FIXED LIFT STRUCTURE                                             -->
  <!-- ================================================================ -->

  <link name="lift_fixed_link">

    <visual name="lift_fixed_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_fixed_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="metal_gray">
        <color rgba="0.45 0.48 0.52 1.0"/>
      </material>
    </visual>

  </link>

  <joint name="lift_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lift_fixed_link"/>

    <origin
      xyz="-0.015 0 0"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- MOVING LIFT PLATFORM                                             -->
  <!-- ================================================================ -->

  <link name="lift_platform_link">

    <visual name="lift_platform_base_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_platform_base_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="lift_orange">
        <color rgba="0.92 0.58 0.08 1.0"/>
      </material>
    </visual>

    <visual name="lift_deck_pad_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_deck_pad_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="deck_pad_gray">
        <color rgba="0.22 0.24 0.26 1.0"/>
      </material>
    </visual>

    <collision name="lift_platform_collision">
      <origin
        xyz="0 0 -0.006"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.650 0.560 0.012"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 -0.010"
        rpy="0 0 0"/>

      <mass value="10.0"/>

      <inertia
        ixx="0.262"
        ixy="0.0"
        ixz="0.0"
        iyy="0.352"
        iyz="0.0"
        izz="0.614"/>
    </inertial>

  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_platform_link"/>

    <origin
      xyz="${lift_x} 0 ${lift_lowered_z}"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="${lift_travel}"
      effort="4000.0"
      velocity="0.08"/>

    <dynamics
      damping="20.0"
      friction="10.0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- MOVING CENTRAL RAM                                               -->
  <!-- ================================================================ -->

  <link name="lift_ram_link">

    <visual name="lift_ram_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_ram_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="silver">
        <color rgba="0.82 0.84 0.88 1.0"/>
      </material>
    </visual>

    <collision name="lift_ram_collision">
      <origin
        xyz="0 0 -0.115"
        rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.015"
          length="0.230"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 -0.115"
        rpy="0 0 0"/>

      <mass value="2.0"/>

      <inertia
        ixx="0.0089"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0089"
        iyz="0.0"
        izz="0.000225"/>
    </inertial>

  </link>

  <joint name="lift_ram_joint" type="fixed">
    <parent link="lift_platform_link"/>
    <child link="lift_ram_link"/>

    <origin
      xyz="0 0 -0.012"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- 20 KG PAYLOAD TRAY WITH 2 CANTILEVERED WINGS & 6 STEEL WEIGHTS    -->
  <!-- ================================================================ -->

  <link name="payload_link">

    <!-- 1. Tote tray body with the 2 cantilevered wings -->
    <visual name="payload_tray_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/payload_tray_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="payload_brown">
        <color rgba="0.72 0.52 0.32 1.0"/>
      </material>
    </visual>

    <!-- 2. Six machined steel cylinder weights inside tray -->
    <visual name="payload_weights_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/payload_weights_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="steel_gray">
        <color rgba="0.62 0.65 0.70 1.0"/>
      </material>
    </visual>

    <!-- Central tray box collision -->
    <collision name="payload_tray_collision">
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.500 0.400 0.050"/>
      </geometry>
    </collision>

    <!-- Left cantilevered wing collision (rests on rack rail at Y = +0.330 m) -->
    <collision name="payload_left_wing_collision">
      <origin xyz="0 0.278 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.420 0.156 0.016"/>
      </geometry>
    </collision>

    <!-- Right cantilevered wing collision (rests on rack rail at Y = -0.330 m) -->
    <collision name="payload_right_wing_collision">
      <origin xyz="0 -0.278 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.420 0.156 0.016"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0.027"
        rpy="0 0 0"/>

      <mass value="20.0"/>

      <inertia
        ixx="0.2708"
        ixy="0.0"
        ixz="0.0"
        iyy="0.4208"
        iyz="0.0"
        izz="0.6833"/>
    </inertial>

  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="lift_platform_link"/>
    <child link="payload_link"/>

    <origin
      xyz="0 0 0.002"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- 2D LIDAR TOWER (ALUMINUM RISER PEDESTAL + SCANNER HOUSING)       -->
  <!-- ================================================================ -->

  <link name="lidar_link">

    <!-- Aluminum riser pedestal tower -->
    <visual name="lidar_pedestal_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lidar_pedestal_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="pedestal_gray">
        <color rgba="0.28 0.30 0.34 1.0"/>
      </material>
    </visual>

    <!-- 2D LiDAR scanner housing & protective cap -->
    <visual name="lidar_unit_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lidar_unit_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.12 0.12 0.14 1.0"/>
      </material>
    </visual>

  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin
      xyz="0.368 0 0.390"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- INTEL REALSENSE D455 CAMERA (ALUMINUM HOUSING + FRONT GLASS)     -->
  <!-- ================================================================ -->

  <link name="camera_link">

    <!-- Aluminum camera body & mounting bracket -->
    <visual name="camera_body_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/camera_body_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="aluminum_silver">
        <color rgba="0.72 0.75 0.78 1.0"/>
      </material>
    </visual>

    <!-- Front optical glass faceplate & blue lenses -->
    <visual name="camera_face_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/camera_face_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>
      <material name="optical_glass">
        <color rgba="0.08 0.08 0.10 1.0"/>
      </material>
    </visual>

  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin
      xyz="0.415 0 0.285"
      rpy="0 0 0"/>
  </joint>


    <!-- ================================================================ -->
  <!-- SCISSOR BAR MACRO                                                -->
  <!--                                                                  -->
  <!-- Each bar is a real URDF link.                                    -->
  <!-- In RViz2, the mimic tag synchronizes the bar with lift_joint.    -->
  <!-- In Gazebo, JointPositionController receives the same angle from  -->
  <!-- lift_gazebo_controller.py.                                      -->
  <!-- ================================================================ -->

  <xacro:macro
    name="scissor_bar"
    params="link_name joint_name joint_x joint_y rotation_z">

    <link name="${link_name}">

      <visual name="${link_name}_visual">
        <origin
          xyz="${scissor_bar_length / 2} 0 0"
          rpy="0 0 0"/>

        <geometry>
          <box
            size="${scissor_bar_length} ${scissor_bar_width} ${scissor_bar_height}"/>
        </geometry>

        <material name="scissor_orange">
          <color rgba="0.82 0.48 0.08 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin
          xyz="${scissor_bar_length / 2} 0 0"
          rpy="0 0 0"/>

        <mass value="0.8"/>

        <inertia
          ixx="0.000034"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00499"
          iyz="0.0"
          izz="0.00499"/>
      </inertial>

    </link>

    <joint
      name="${joint_name}"
      type="revolute">

      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="${joint_x} ${joint_y} ${scissor_lower_z}"
        rpy="0 0 ${rotation_z}"/>

      <axis xyz="0 -1 0"/>

      <limit
        lower="0.154"
        upper="0.890"
        effort="300.0"
        velocity="1.5"/>

      <dynamics
        damping="1.0"
        friction="0.2"/>

      <!--
        RViz2 synchronization:
        Lowered lift: h = 0.000 m -> angle = 0.154 rad (8.8 deg)
        Raised lift:  h = 0.290 m -> angle = 0.890 rad (51.0 deg)
        Linear approximation: multiplier = (0.890 - 0.154) / 0.290 = 2.538
      -->

      <mimic
        joint="lift_joint"
        multiplier="2.538"
        offset="0.154"/>

    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- LEFT SCISSOR PAIR                                                -->
  <!-- ================================================================ -->

  <xacro:scissor_bar
    link_name="scissor_left_a_link"
    joint_name="scissor_left_a_joint"
    joint_x="${scissor_center_x - scissor_x_offset}"
    joint_y="${scissor_y_outer}"
    rotation_z="0.0"/>

  <xacro:scissor_bar
    link_name="scissor_left_b_link"
    joint_name="scissor_left_b_joint"
    joint_x="${scissor_center_x + scissor_x_offset}"
    joint_y="${scissor_y_inner}"
    rotation_z="${pi}"/>


  <!-- ================================================================ -->
  <!-- RIGHT SCISSOR PAIR                                               -->
  <!-- ================================================================ -->

  <xacro:scissor_bar
    link_name="scissor_right_a_link"
    joint_name="scissor_right_a_joint"
    joint_x="${scissor_center_x - scissor_x_offset}"
    joint_y="${-scissor_y_outer}"
    rotation_z="0.0"/>

  <xacro:scissor_bar
    link_name="scissor_right_b_link"
    joint_name="scissor_right_b_joint"
    joint_x="${scissor_center_x + scissor_x_offset}"
    joint_y="${-scissor_y_inner}"
    rotation_z="${pi}"/>


  <!-- ================================================================ -->
  <!-- GAZEBO PHYSICS & WHEEL FRICTION                                  -->
  <!-- (Rich visual colors are defined directly via URDF visual tags)   -->
  <!-- ================================================================ -->

  <gazebo reference="left_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>


  <!-- ================================================================ -->
  <!-- LOW-FRICTION CASTER CONTACTS                                     -->
  <!-- ================================================================ -->

  <gazebo reference="caster_front_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_front_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_rear_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_rear_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>


  <!-- ================================================================ -->
  <!-- GAZEBO FORTRESS DIFFERENTIAL DRIVE                               -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>${prefix}/cmd_vel</topic>
      <odom_topic>${prefix}/odom</odom_topic>
      <tf_topic>${prefix}/tf</tf_topic>

      <frame_id>${prefix}/odom</frame_id>
      <child_frame_id>${prefix}/base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_velocity>1.2</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>

      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>

    </plugin>


    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">

      <topic>${prefix}/joint_states</topic>

      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>lift_joint</joint_name>

      <joint_name>scissor_left_a_joint</joint_name>
      <joint_name>scissor_left_b_joint</joint_name>
      <joint_name>scissor_right_a_joint</joint_name>
      <joint_name>scissor_right_b_joint</joint_name>

    </plugin>

  </gazebo>


  <!-- ================================================================ -->
  <!-- MAIN LIFT POSITION CONTROLLER                                    -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>lift_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>${prefix}/lift_position</topic>

      <p_gain>5000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>150.0</d_gain>

      <i_max>100.0</i_max>
      <i_min>-100.0</i_min>

    </plugin>

  </gazebo>


  <!-- ================================================================ -->
  <!-- FOUR SCISSOR JOINT CONTROLLERS                                   -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_left_a_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>${prefix}/scissor_left_a_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_left_b_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>${prefix}/scissor_left_b_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_right_a_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>${prefix}/scissor_right_a_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_right_b_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>${prefix}/scissor_right_b_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>

</robot>