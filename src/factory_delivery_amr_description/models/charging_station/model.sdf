          <box>
            <size>0.160 0.380 0.596</size>
          </box>
        </geometry>
      </collision>

      <collision name="base_collision">
        <pose>0.135 0 0.008 0 0 0</pose>
        <geometry>
          <box>
            <size>0.290 0.540 0.016</size>
          </box>
        </geometry>
      </collision>
    </link>
