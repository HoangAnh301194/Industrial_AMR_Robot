<?xml version="1.0"?>
<sdf version="1.9">
  <model name="charging_station">
    <static>true</static>
    <link name="charging_station_link">
      <visual name="charging_station_visual">
        <geometry>
          <mesh>
            <uri>model://charging_station/meshes/charging_station_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.24 0.28 0.35 1.0</diffuse>
          <ambient>0.24 0.28 0.35 1.0</ambient>
