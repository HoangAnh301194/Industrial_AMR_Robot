<?xml version="1.0"?>
<package format="3">
  <name>factory_delivery_amr_navigation</name>
  <version>0.1.0</version>

  <description>
    Autonomous SLAM mapping (slam_toolbox), Nav2 navigation stack,
    warehouse map management, and autonomous delivery mission execution
    for the Factory Delivery AMR.
  </description>

  <maintainer email="nhat@example.com">Nguyen Xuan Nhat</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>factory_delivery_amr_description</exec_depend>
  <exec_depend>factory_delivery_amr_gazebo</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
